# Required for protected posts/albums.
PROTECTED_SESSION_SECRET=
# Generate with: openssl rand -base64 32
# iron-session requires a session password of at least 32 characters.

# Upstash Redis for in-app rate limiting.
# The Vercel Marketplace integration injects these automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
